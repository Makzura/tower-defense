# macOS archive junk that shipped inside the zip
__MACOSX/
.DS_Store
**/.DS_Store

# Python bytecode from the model build scripts
**/__pycache__/
*.pyc

# Blender autosaves
*.blend1

# Obsidian vault config that lives in this folder but is not the game
.obsidian/
*.canvas

# Another session's git worktrees; not part of the game
.claude/worktrees/
**/.claude/worktrees/
visual-pass/tmp/

# Agent company: runtime data, not knowledge
.claude/org/log/
.claude/org/status/*.jsonl
tools/org/tree.html
